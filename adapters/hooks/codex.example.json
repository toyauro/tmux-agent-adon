{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$LAMP_HOOK\" codex UserPromptSubmit",
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$LAMP_HOOK\" codex PermissionRequest",
            "timeout": 2
          }
        ]
      }
